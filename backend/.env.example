# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Django Application Settings
SECRET_KEY=replace-with-your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Production only — comma-separated list of trusted origins for CSRF
# In Render: set to https://<your-service-name>.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000
