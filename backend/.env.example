# ============================================================
# FarmCart Environment Configuration Template
# Maintainer: Agile 11 / Anshika Sharma (Deployment Manager)
# Copy this file to .env and customize for your local setup.
# DO NOT commit real secrets or credentials to source control.
# ============================================================

# Database Connection URL:
# For Local Zero-Setup Development (SQLite):
DATABASE_URL=sqlite:///./farmcart.db

# For Production or Docker Compose (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://farmcart_user:farmcart_password@localhost:5432/farmcart
# In Docker Compose, use host 'db':
# DATABASE_URL=postgresql+psycopg2://farmcart_user:farmcart_password@db:5432/farmcart

# JWT Authentication
# Generate a cryptographically secure random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform Economics Configuration
# Platform commission fee percentage deducted from gross produce value
PLATFORM_FEE_PERCENT=8.0

# Platform logistics markup percentage applied to transport cost
LOGISTICS_SHARE_PERCENT=15.0

# ============================================================
# Phase 2: Payment Gateway & Escrow Settlement Configuration
# ============================================================
# Gateway Provider: "mock" (offline test simulation) | "razorpay" (real gateway)
PAYMENT_PROVIDER=mock
# Gateway Mode: "sandbox" | "live"
PAYMENT_MODE=sandbox
PAYMENT_KEY_ID=rzp_test_placeholder
PAYMENT_KEY_SECRET=rzp_secret_placeholder
PAYMENT_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
PAYMENT_CALLBACK_URL=http://localhost:8000/payments/callback
PAYMENT_WEBHOOK_URL=http://localhost:8000/payments/webhooks/razorpay
# Strict guard: Set to True only when valid production credentials are onboarded
PAYMENT_LIVE_ENABLED=false

# ============================================================
# Phase 2: Timing, Windows & Upload Buffers
# ============================================================
# Buyer review & dispute filing window after delivery (hours)
BUYER_CONFIRMATION_PERIOD_HOURS=24.0
DISPUTE_WINDOW_HOURS=24.0

# Upload storage directory for private dispute photo evidence
UPLOAD_DIR=./uploads/disputes
MAX_UPLOAD_SIZE_MB=5

# ============================================================
# Phase 2: Delivery Batching & Scheduling Configuration Defaults
# ============================================================
DEFAULT_MIN_BATCH_THRESHOLD_KG=25.0
DEFAULT_MAX_BATCH_WEIGHT_KG=1000.0
DEFAULT_MAX_BATCH_ORDERS=50
DEFAULT_PREP_BUFFER_HOURS=4.0
DEFAULT_DISPATCH_BUFFER_HOURS=2.0
