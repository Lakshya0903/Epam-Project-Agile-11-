# ============================================================
# FarmCart Environment Configuration Template
# Maintainer: Anshika Sharma (Deployment Manager)
# Copy this file to .env and customize for your local setup.
# DO NOT commit real secrets or credentials to source control.
# ============================================================

# Database Connection URL:
# For Local Zero-Setup Development (SQLite):
DATABASE_URL=sqlite:///./farmcart.db

# For Production or Docker Compose (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://farmcart_user:farmcart_password@localhost:5432/farmcart
# In Docker Compose, use host 'db':
# DATABASE_URL=postgresql+psycopg2://farmcart_user:farmcart_password@db:5432/farmcart

# JWT Authentication
# Generate a cryptographically secure random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform Economics Configuration
# Platform commission fee percentage deducted from gross produce value
PLATFORM_FEE_PERCENT=8.0

# Platform logistics markup percentage applied to transport cost
LOGISTICS_SHARE_PERCENT=15.0
